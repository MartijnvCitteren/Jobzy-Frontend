{
  "name": "talmar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && steiger ./src && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.module.css\"",
    "steiger": "steiger ./src",
    "e2e": "playwright test",
    "generate:api": "openapi-typescript specs/vacancy.yml -o src/shared/api/generated/vacancy-api.ts",
    "storybook": "storybook dev -p 6006",
    "build-keycloak-theme": "npm run build && keycloakify build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "keycloakify": "11.16.4",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@feature-sliced/steiger-plugin": "^0.5.2",
    "@playwright/test": "^1.49.1",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.2",
    "playwright": "^1.49.1",
    "steiger": "^0.5.7",
    "storybook": "10.6.3",
    "stylelint": "^16.26.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
